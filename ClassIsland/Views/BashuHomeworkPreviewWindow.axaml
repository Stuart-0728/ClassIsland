<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClassIsland.ViewModels" x:Class="ClassIsland.Views.BashuHomeworkPreviewWindow"
        x:DataType="vm:BashuHomeworkPreviewViewModel" Title="班级作业"
        Width="440" Height="690" MinWidth="340" MinHeight="320" MaxWidth="720"
        Topmost="True" ShowInTaskbar="True" SystemDecorations="None" CanResize="True"
        Background="Transparent" TransparencyLevelHint="Transparent" FontFamily="Microsoft YaHei UI, PingFang SC, sans-serif"
        FontSize="{Binding TextSize}" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#667873"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#263C36"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#82908C"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#00897B"/><Setter Property="Foreground" Value="White"/></Style>
  </Window.Styles>
  <Border Margin="8" CornerRadius="16" Background="#FAFCFB" BorderBrush="#DAE5E1" BorderThickness="1" BoxShadow="0 3 10 0 #200F382E" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border Padding="18,14" Background="White" PointerPressed="Header_OnPointerPressed">
        <Grid>
          <Grid IsVisible="{Binding Expanded}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="5">
              <TextBlock Text="班级作业" FontSize="20" FontWeight="Bold"/>
              <TextBlock Text="{Binding ContextLabel}" Classes="muted" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
              <Button x:Name="FoldButton" Content="收起" Classes="quiet" Click="Fold_OnClick" AutomationProperties.Name="收起作业悬浮窗"/>
              <Button Content="×" Classes="quiet" FontSize="19" Click="Close_OnClick" AutomationProperties.Name="关闭作业悬浮窗"/>
            </StackPanel>
          </Grid>
          <Grid IsVisible="{Binding !Expanded}" ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
            <Border Background="#00897B" CornerRadius="2"/>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="班级作业" FontSize="15" FontWeight="Bold"/>
              <Canvas x:Name="CompactViewport" Height="18" ClipToBounds="True">
                <TextBlock x:Name="CompactTicker" Text="{Binding CompactText}" FontSize="12" Foreground="#008578" Canvas.Left="0"/>
              </Canvas>
            </StackPanel>
            <Button x:Name="ExpandButton" Grid.Column="2" Content="展开" Classes="quiet" VerticalAlignment="Center" Click="Fold_OnClick" AutomationProperties.Name="展开作业悬浮窗"/>
          </Grid>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" IsVisible="{Binding Expanded}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,16,12" Spacing="12">
          <Border Background="#EAF5F1" Padding="12,9" CornerRadius="8">
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#227C69" TextWrapping="Wrap"/>
          </Border>
          <Border IsVisible="{Binding IsEmpty}" Padding="20,40">
            <StackPanel Spacing="8"><TextBlock Text="暂无作业" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="老师布置后会自动显示在这里" Classes="muted" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BashuHomeworkPreviewCard">
                <Border Padding="16,14" Background="White" BorderBrush="#E3EBE7" BorderThickness="1" CornerRadius="12">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,2">
                      <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Border Grid.Column="1" Background="{Binding StatusBackground}" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12"/></Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#62756D"/>
                    <TextBlock Text="{Binding Deadline}" Classes="muted" TextWrapping="Wrap"/>
                    <Border Height="1" Background="#EFF3F1" Margin="0,3"/>
                    <TextBlock Text="{Binding Counts}" Classes="muted" TextWrapping="Wrap"/>
                    <Border IsVisible="{Binding HasNames}" Background="#FFF8EB" CornerRadius="7" Padding="10,8">
                      <StackPanel Spacing="4"><TextBlock Text="待补交" FontSize="11" Foreground="#AD7B32"/><TextBlock Text="{Binding Names}" Foreground="#865D22" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>
</Window>
